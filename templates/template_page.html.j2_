{# template_page.html.j2 — повна WP-сторінка з усіма роками і колекціями #}
<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Кваліфікаційні роботи ПФ</title>
</head>
<body>

<div style="font-family: Arial, sans-serif; line-height: 1.6; max-width: 1100px; margin: 0 auto;">

  {# ── Шапка з постійними посиланнями ── #}
  <div style="border-left: 4px solid #3949ab; background: #f5f7ff; padding: 18px 20px; margin: 25px 0; border-radius: 6px;">
    <div style="font-size: 18px; font-weight: 600; color: #1a237e; margin-bottom: 12px;">Постійні посилання на ela.kpi.ua</div>
    <ul>
      <li><a style="color: #0d47a1; text-decoration: none; font-weight: 600;"
             href="https://ela.kpi.ua/collections/{{ collection_uuids.magistr }}">Магістерські дисертації</a></li>
      <li><a style="color: #0d47a1; text-decoration: none; font-weight: 600;"
             href="https://ela.kpi.ua/collections/{{ collection_uuids.bakalavr }}">Бакалаврські роботи</a></li>
    </ul>
    <div style="margin-top: 18px; padding-top: 12px; border-top: 1px solid #c5cae9;">
      <span style="font-weight: 600;">Записи захистів кваліфікаційних робіт:&nbsp;</span> 
      <a style="color: #b71c1c; font-weight: 600; text-decoration: none;" href="https://www.youtube.com/playlist?list=PLjd3PvSesgEzfZxXOtwrjLOSYK4d25he7">YouTube-канал кафедри</a>
    </div>
  </div>

  {# ── Контент по роках ── #}
  {% for year in years %}

  <h2 style="color: #1a237e; border-bottom: 2px solid #3949ab; padding-bottom: 6px;">{{ year }} рік</h2>

    {% for col in col_order %}
    {% if year in grouped[col] %}
    {% set works = grouped[col][year] %}

    <h3 style="color: #283593; margin-top: 12px;">{{ collection_labels[col] }}</h3>

    <div style="overflow-x:auto">
    <table style="width: 100%; min-width: 600px; border-collapse: collapse; font-family: Arial, sans-serif; font-size: 13px; margin-bottom: 24px;">      <thead>
        <tr>
          <th style="background: #1a5276; color: #fff; padding: 10px 12px; text-align: center; border: 1px solid #ccc; width: 36px;">№</th>
          <th style="background: #1a5276; color: #fff; padding: 10px 12px; text-align: left; border: 1px solid #ccc;">ПІБ</th>
          <th style="background: #1a5276; color: #fff; padding: 10px 12px; text-align: left; border: 1px solid #ccc;">Назва роботи</th>
          <th style="background: #1a5276; color: #fff; padding: 10px 12px; text-align: left; border: 1px solid #ccc;">ПІБ керівника</th>
          <th style="background: #1a5276; color: #fff; padding: 10px 12px; text-align: left; border: 1px solid #ccc; width: 90px;">Посилання</th>
        </tr>
      </thead>
      <tbody>
        {% for work in works %}
        {% set bg = "#f0f4f8" if loop.index is odd else "#ffffff" %}
        <tr>
          <td style="padding: 8px 12px; border: 1px solid #ccc; text-align: center; background: {{ bg }};">{{ loop.index }}</td>
          <td style="padding: 8px 12px; border: 1px solid #ccc; background: {{ bg }};">{{ work.authors | join(", ") }}</td>
          <td style="padding: 8px 12px; border: 1px solid #ccc; background: {{ bg }};">{{ work.title or "—" }}</td>
          <td style="padding: 8px 12px; border: 1px solid #ccc; background: {{ bg }};">{{ work.advisors | join(", ") }}</td>
          <td style="padding: 8px 12px; border: 1px solid #ccc; text-align: center; background: {{ bg }};">
            {% if work.url %}
            <a href="{{ work.url }}">
              <img src="https://ela.kpi.ua/assets/cusdspace/images/elakpi-logo.webp"
                   alt="ela.kpi.ua" width="78" height="31">
            </a>
            {% else %}
            —
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>

    {% endif %}
    {% endfor %}

  {% endfor %}

</div>

</body>
</html>
